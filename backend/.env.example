# Database (uses psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cartiva

# LLM (leave empty — integrated in a later task)
LLM_API_KEY=
LLM_MODEL=
LLM_PROVIDER=mock

# Razorpay (leave empty — integrated in a later task)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Usage limits (configurable — not hard-coded)
FREE_MONTHLY_AI_SESSIONS=10

# App
CORS_ORIGINS=http://localhost:3000
