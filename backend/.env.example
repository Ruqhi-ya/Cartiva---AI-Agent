# Database (uses psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cartiva

# LLM
LLM_API_KEY=
LLM_MODEL=
LLM_PROVIDER=mock

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# JWT authentication
CARTIVA_JWT_SECRET=

# Authentication cookie
# false for local HTTP, true for production HTTPS
COOKIE_SECURE=false

# Usage limits
FREE_MONTHLY_AI_SESSIONS=10

# App
CORS_ORIGINS=http://localhost:3000